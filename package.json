{
  "name": "p5",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist --env=\"\"",
    "deploy": "wrangler deploy --env dev",
    "deploy:dev": "wrangler deploy --env dev",
    "deploy:production": "wrangler deploy --env production",
    "dev": "wrangler dev",
    "start": "wrangler dev",
    "test": "vitest run test/index.spec.ts",
    "test:coverage": "vitest run test/index.spec.ts --coverage",
    "test:uat": "vitest run test/uat.spec.ts --reporter=default --reporter=json --outputFile=test-results/uat.json",
    "test:watch": "vitest",
    "cf-typegen": "wrangler types"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.0.0",
    "@types/node": "^26.6.1",
    "@vitest/coverage-istanbul": "^4.1.11",
    "typescript": "^5.5.2",
    "vitest": "~4.1.0",
    "wrangler": "^4.134.0"
  }
}
